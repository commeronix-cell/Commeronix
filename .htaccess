# ==============================================================================
# COMMERONIX - APACHE & LITESPEED CONFIGURATION
# Enforces HTTPS, Non-WWW, Clean Permalinks, Security Headers & 404
# ==============================================================================

Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. Force Canonical Non-WWW (redirect www.commeronix.com -> commeronix.com)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]

# 3. Clean up legacy WordPress/cPanel query parameters (e.g. /?p=1 -> /)
RewriteCond %{QUERY_STRING} ^p=[0-9]+$ [NC]
RewriteRule ^$ /? [R=301,L]

# 4. Redirect /index.html or /index to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s\?] [NC]
RewriteRule ^ / [R=301,L]

# 5. Force Remove .html extension (Clean 301 redirect for all other pages)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^\s\?]+)\.html[\s\?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 6. Remove Trailing Slashes from Non-Directories (Normalize permalinks to /page)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 7. Internally map clean URL to .html file (LiteSpeed & Apache compatible)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f [OR]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# 8. Custom 404 Error Page
ErrorDocument 404 /404.html

# Security & No-Cache Headers for Instant HTML Updates
<IfModule mod_headers.c>
  # HTTP Strict Transport Security (HSTS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.(html|htm|php|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
